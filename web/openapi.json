{
  "openapi": "3.1.0",
  "components": {
    "schemas": {
      "DayResponse": {
        "type": "object",
        "required": [
          "date",
          "generated_at",
          "data_as_of",
          "incomplete",
          "network",
          "categories",
          "running_trips",
          "running_late_trips"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          },
          "data_as_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "incomplete": {
            "type": "boolean"
          },
          "network": {
            "$ref": "#/components/schemas/TotalsDto"
          },
          "categories": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TotalsDto"
            }
          },
          "running_trips": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "running_late_trips": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "generated_at",
          "data_as_of",
          "data_age_s",
          "running_trips",
          "gtfs_loaded"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          },
          "data_as_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_age_s": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "running_trips": {
            "type": "integer",
            "format": "int64"
          },
          "gtfs_loaded": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "HourlyDto": {
        "type": "object",
        "required": [
          "hour",
          "category",
          "totals"
        ],
        "properties": {
          "hour": {
            "type": "integer",
            "format": "int32"
          },
          "category": {
            "type": "string"
          },
          "totals": {
            "$ref": "#/components/schemas/TotalsDto"
          }
        }
      },
      "HourlyResponse": {
        "type": "object",
        "required": [
          "date",
          "generated_at",
          "data_as_of",
          "incomplete",
          "hours"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          },
          "data_as_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "incomplete": {
            "type": "boolean"
          },
          "hours": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HourlyDto"
            }
          },
          "source": {
            "type": "string"
          }
        }
      },
      "LeaderboardResponse": {
        "type": "object",
        "required": [
          "date",
          "generated_at",
          "data_as_of",
          "incomplete",
          "most_total_delay",
          "highest_delay_per_trip",
          "worst_punctuality"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          },
          "data_as_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "incomplete": {
            "type": "boolean"
          },
          "most_total_delay": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteRankDto"
            }
          },
          "highest_delay_per_trip": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteRankDto"
            }
          },
          "worst_punctuality": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteRankDto"
            }
          },
          "source": {
            "type": "string"
          }
        }
      },
      "RecordDto": {
        "type": "object",
        "required": [
          "trip_id",
          "line",
          "headsign",
          "delay_s",
          "at",
          "stop_id",
          "flagged",
          "verified"
        ],
        "properties": {
          "trip_id": {
            "type": "string"
          },
          "line": {
            "type": "string"
          },
          "headsign": {
            "type": [
              "string",
              "null"
            ]
          },
          "delay_s": {
            "type": "integer",
            "format": "int32"
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          },
          "stop_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "flagged": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          }
        }
      },
      "RecordResponse": {
        "type": "object",
        "required": [
          "date",
          "generated_at",
          "data_as_of",
          "incomplete",
          "record"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          },
          "data_as_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "incomplete": {
            "type": "boolean"
          },
          "record": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecordDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string"
          }
        }
      },
      "RouteRankDto": {
        "type": "object",
        "required": [
          "line",
          "category",
          "mode",
          "route_name",
          "route_id",
          "totals",
          "average_max_delay_s"
        ],
        "properties": {
          "line": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "route_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "route_id": {
            "type": "string"
          },
          "totals": {
            "$ref": "#/components/schemas/TotalsDto"
          },
          "average_max_delay_s": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        }
      },
      "TotalsDto": {
        "type": "object",
        "required": [
          "trips_total",
          "trips_finished",
          "trips_canceled",
          "dep_total",
          "dep_on_time",
          "dep_early",
          "dep_late",
          "dep_late_sum",
          "sum_max_delay",
          "punctuality_pct",
          "average_late_delay_s"
        ],
        "properties": {
          "trips_total": {
            "type": "integer",
            "format": "int32"
          },
          "trips_finished": {
            "type": "integer",
            "format": "int32"
          },
          "trips_canceled": {
            "type": "integer",
            "format": "int32"
          },
          "dep_total": {
            "type": "integer",
            "format": "int32"
          },
          "dep_on_time": {
            "type": "integer",
            "format": "int32"
          },
          "dep_early": {
            "type": "integer",
            "format": "int32"
          },
          "dep_late": {
            "type": "integer",
            "format": "int32"
          },
          "dep_late_sum": {
            "type": "integer",
            "format": "int64"
          },
          "sum_max_delay": {
            "type": "integer",
            "format": "int64"
          },
          "punctuality_pct": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "average_late_delay_s": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        }
      }
    }
  },
  "paths": {
    "/api/day/{date}": {
      "get": {
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayResponse"
                }
              }
            }
          }
        },
        "summary": "Day",
        "tags": [
          "Day Resource"
        ]
      }
    },
    "/api/day/{date}/hourly": {
      "get": {
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HourlyResponse"
                }
              }
            }
          }
        },
