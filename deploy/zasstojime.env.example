# Env soubor služby zasstojime (/opt/zasstojime/config/zasstojime.env, práva 0600).
# Zakládá ho deploy/01-zasstojime.sh; význam proměnných: docs/technicke.md – Konfigurace.

# API klíč Golemia (https://api.golemio.cz/api-keys)
GOLEMIO_API_KEY=zmen-me

# Sdílený PostgreSQL (postgres-db, CT 124). Databázi a roli zakládá
# homelab/postgres-db/add-database.sh, heslo vypíše jednou.
DATABASE_URL=jdbc:postgresql://10.140.0.135:5432/zasstojime
DATABASE_USER=zasstojime
DATABASE_PASSWORD=zmen-me

# Doména webu, až bude veřejné API (ADR-0026)
# CORS_ORIGIN=https://example.cz

# Volitelné, výchozí hodnoty viz docs/technicke.md – Konfigurace
# POLL_INTERVAL_S=30
# TRIP_TIMEOUT_S=900
# MAX_DELAY_JUMP_S=120
# ALERT_DELAY_S=7200
